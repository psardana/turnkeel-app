# Configuration for development. The server names every variable that is missing or half set
# when it starts.
#
# The server reads its configuration from the environment. Copy this file to .env and
# load it into the process that starts the server. .env is not committed.
# The values below match docker-compose.yml and are for development only.

# --- Server ---------------------------------------------------------------
# Without TURNKEEL_PUBLIC_URL the server runs local mode: no sign-in, loopback only.
# TURNKEEL_PUBLIC_URL=http://localhost:4400
TURNKEEL_HOST=127.0.0.1
TURNKEEL_PORT=4400

# Needed whenever sign-in is on. Make your own: openssl rand -base64 32
# TURNKEEL_AUTH_SECRET=
# Encrypts stored secrets: a workspace's key for the assistant, and connector secrets.
# Without it a server with sign-in stores no key; local mode makes its own key file.
# At least 32 characters. Make your own: openssl rand -base64 32
# TURNKEEL_SECRETS_KEY=
# TURNKEEL_OPEN_SIGNUP=false
# Behind a reverse proxy: its address or range, so that sign-in requests are counted
# under the client's address and not the proxy's. Several with commas between them.
# TURNKEEL_TRUSTED_PROXIES=

# --- Database -------------------------------------------------------------
# Without DATABASE_URL the server runs on PGlite in TURNKEEL_DATA_DIR (~/.turnkeel).
# DATABASE_URL=postgres://turnkeel:turnkeel@127.0.0.1:54420/turnkeel
# DATABASE_URL_DIRECT=
# TURNKEEL_DATA_DIR=

# The integration tests that need Postgres run when this is set.
# TEST_DATABASE_URL=postgres://turnkeel:turnkeel@127.0.0.1:54420/turnkeel_test

# --- Files ----------------------------------------------------------------
# Without S3_ENDPOINT files are kept in a folder under the data folder.
# S3_ENDPOINT=http://127.0.0.1:9400
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9400
# S3_BUCKET=turnkeel
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=turnkeel
# S3_SECRET_ACCESS_KEY=turnkeel-dev-secret
# S3_FORCE_PATH_STYLE=true
# TURNKEEL_MAX_FILE_BYTES=104857600

# --- Mail -----------------------------------------------------------------
# Without SMTP_URL sign-in links and invitations are written to the server log.
# SMTP_URL=smtp://127.0.0.1:4426
# MAIL_FROM=Turnkeel <turnkeel@localhost>

# --- Sign-in with GitHub and Google (each needs both values) ----------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- The assistant ------------------------------------------
# An install-wide default provider. It turns nothing on: an Owner or Admin chooses it
# and turns the assistant on in a workspace. No effect with TURNKEEL_OPEN_SIGNUP=true.
# A model server on this machine, such as Ollama:
# TURNKEEL_ASSISTANT_PROVIDER=openai-compatible
# TURNKEEL_ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
# TURNKEEL_ASSISTANT_MODEL=
# Needed for anthropic. Whoever runs the server pays for what is called with it.
# TURNKEEL_ASSISTANT_API_KEY=
# The most calls a day of all workspaces together that use the default. 100 unless set.
# TURNKEEL_ASSISTANT_DAILY_CAP=100

# --- The CLI ----------------------------------------------------------------
# TURNKEEL_URL=http://127.0.0.1:4400
# TURNKEEL_TOKEN=

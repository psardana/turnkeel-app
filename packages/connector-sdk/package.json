{
  "name": "@turnkeel/connector-sdk",
  "version": "0.0.0",
  "description": "The contract a Turnkeel connector implements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psardana/turnkeel-app.git",
    "directory": "packages/connector-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
